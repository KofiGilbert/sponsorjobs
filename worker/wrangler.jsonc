// The SponsorJobs broker Worker, deployed to the BlackOrigin Cloudflare account (which also holds
// the sponsorjobs.ai zone) at https://api.sponsorjobs.ai. Account and database ids are not
// secrets; the key is (see below).
//
// Secrets (set once with `npx wrangler secret put <NAME>`, never written in this file):
//   ANTHROPIC_API_KEY   the company Anthropic key; without it /health reports
//                       real_providers:false and /llm/complete answers 503.
//   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_PASS30, STRIPE_PRICE_PASS90,
//   STRIPE_PRICE_PACK_1, STRIPE_PRICE_PACK_3, STRIPE_PRICE_PACK_5
//                       Stripe billing (docs/stripe-setup.md); without the key and a pass price
//                       every /billing/* route answers "billing is not configured".
//   RESEND_API_KEY      e-mail sign-in codes (docs/sign-in-setup.md); without it
//                       /account/email/* answers "email sign-in is not configured".
//   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
//                       "Continue with Google"; without both /account/google/* answers
//                       "google sign-in is not configured".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sponsorjobs-broker",
  "main": "src/index.ts",
  "account_id": "61cbc2bf5c4514a08662576605bad356",
  // The official desktop edition calls api.sponsorjobs.ai (shell-electron/main.js).
  // admin.sponsorjobs.ai is the founder's read-only dashboard (src/admin.ts). It must sit behind a
  // Cloudflare Access application (docs/admin-dashboard.md); without ACCESS_TEAM_DOMAIN and
  // ACCESS_AUD below it answers 403 to everyone.
  "routes": [
    { "pattern": "api.sponsorjobs.ai", "custom_domain": true },
    { "pattern": "admin.sponsorjobs.ai", "custom_domain": true }
  ],
  // 2026-08-22 is the newest date the test runtime (pinned by @cloudflare/vitest-pool-workers)
  // supports; keeping production on the same date means the tests exercise the same runtime
  // behaviour that ships. Nothing here needs a newer flag.
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sponsorjobs-broker",
      "database_id": "e1bb6376-c3c6-489d-aa32-a10eed4fdb96",
      "migrations_dir": "migrations"
    },
    // The job search index (src/search.ts, docs/server-search-plan.md), written only by
    // scripts/load_search_index.py. Its own database so search never queues behind the broker.
    // PLACEHOLDER id: before the next deploy the owner runs `npx wrangler d1 create
    // sponsorjobs-search`, pastes the id it prints here, and applies its migrations with
    // `npx wrangler d1 migrations apply SEARCH_DB --remote`. A deploy with this placeholder fails.
    {
      "binding": "SEARCH_DB",
      "database_name": "sponsorjobs-search",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations-search"
    }
  ],

  // Job search rate limits (src/search.ts): 60 a minute per install token, 300 per network. The
  // namespace ids are our own labels (any number unique in the account), not created resources.
  // Approximate and per Cloudflare location; a WAF rate-limit rule is the backstop.
  "ratelimits": [
    { "name": "SEARCH_TOKEN_LIMITER", "namespace_id": "7101", "simple": { "limit": 60, "period": 60 } },
    { "name": "SEARCH_IP_LIMITER", "namespace_id": "7102", "simple": { "limit": 300, "period": 60 } }
  ],

  // Defaults matching backend/broker.py and backend/metering.py. Override per deployment here or
  // in the dashboard; they are plain settings, not secrets.
  "vars": {
    "REGISTER_PER_IP_PER_DAY": "50",
    "FREE_POOL_DAILY_TOKENS": "5000000",
    "TAILOR_FREE_MODEL": "",
    "TAILOR_PASS_MODEL": "",
    // "1" accepts the X-Tailor-User dev header in place of a token. Never in production.
    "DEV_HEADER_AUTH": "0",
    // Admin dashboard (docs/admin-dashboard.md). Not secrets: the Zero Trust team name (e.g.
    // "sponsorjobs") and the Access application's AUD tag. Empty = the dashboard stays closed (403).
    "ACCESS_TEAM_DOMAIN": "sponsorjobs",
    "ACCESS_AUD": "de6e7ffefd4c65fc94bbf637a366a6374bb0c865bbca1264d735bfed03fce867",
    // Optional extra lock, comma-separated: only these e-mails get in, even if Access lets more through.
    "ADMIN_EMAILS": ""
  }
}
