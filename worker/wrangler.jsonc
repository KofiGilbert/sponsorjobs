// The SponsorJobs broker Worker, deployed to the BlackOrigin Cloudflare account (which also holds
// the sponsorjobs.ai zone) at https://api.sponsorjobs.ai. Account and database ids are not
// secrets; the key is (see below).
//
// Secrets (set once with `npx wrangler secret put <NAME>`, never written in this file):
//   ANTHROPIC_API_KEY   the company Anthropic key; without it /health reports
//                       real_providers:false and /llm/complete answers 503.
//   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_PASS30, STRIPE_PRICE_PASS90,
//   STRIPE_PRICE_PACK_1, STRIPE_PRICE_PACK_3, STRIPE_PRICE_PACK_5
//                       Stripe billing (docs/stripe-setup.md); without the key and a pass price
//                       every /billing/* route answers "billing is not configured".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sponsorjobs-broker",
  "main": "src/index.ts",
  "account_id": "61cbc2bf5c4514a08662576605bad356",
  // The official desktop edition calls this address (shell-electron/main.js).
  "routes": [{ "pattern": "api.sponsorjobs.ai", "custom_domain": true }],
  // 2026-08-22 is the newest date the test runtime (pinned by @cloudflare/vitest-pool-workers)
  // supports; keeping production on the same date means the tests exercise the same runtime
  // behaviour that ships. Nothing here needs a newer flag.
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sponsorjobs-broker",
      "database_id": "e1bb6376-c3c6-489d-aa32-a10eed4fdb96",
      "migrations_dir": "migrations"
    }
  ],

  // Defaults matching backend/broker.py and backend/metering.py. Override per deployment here or
  // in the dashboard; they are plain settings, not secrets.
  "vars": {
    "REGISTER_PER_IP_PER_DAY": "50",
    "FREE_POOL_DAILY_TOKENS": "5000000",
    "TAILOR_FREE_MODEL": "",
    "TAILOR_PASS_MODEL": "",
    // "1" accepts the X-Tailor-User dev header in place of a token. Never in production.
    "DEV_HEADER_AUTH": "0"
  }
}
