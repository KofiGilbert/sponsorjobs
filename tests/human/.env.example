# Copy to tests/human/.env (git-ignored) and fill in. Midscene reads these.
# Gemini via Google AI Studio's OpenAI-compatible endpoint. Use a key from a project WITH
# billing on: on the free tier Google may use the screenshots (your profile, your jobs) to
# improve its products.
MIDSCENE_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=gemini-3.6-flash
MIDSCENE_MODEL_FAMILY=gemini

# Optional
# MIDSCENE_MODEL_REASONING_ENABLED=false   # default set in playwright.config.ts (cheaper)
# SJ_CDP_URL=http://127.0.0.1:9233         # the dev window's remote-debugging port
# SJ_APP_URL_MATCH=127.0.0.1:57010         # picks the SponsorJobs tab, never a job-site tab
