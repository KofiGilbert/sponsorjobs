  "question_patterns": {
    "work_auth_us": {
      "label_re": "authoriz(ed|ation) to work|legally (able|authorized|permitted|eligible) to work|eligible to work|right to work|work authoriz|lawfully (able|authorized)",
      "answer_from": "work_auth_us",
      "answers": [
        "Yes",
        "No"
      ]
    },
    "needs_sponsorship": {
      "label_re": "sponsor|require.*visa|visa.*(status|sponsor|support)|employment visa|immigration (support|sponsor)",
      "future_re": "now or in the future|in the future|will you (ever|at any time)|future",
      "answer_from": "needs_sponsorship",
      "answers": [
        "Yes",
        "No",
        "Future"
      ]
    },
    "eeo_decline": {
      "label_re": "gender|\\brace\\b|ethnic|veteran|disab|sexual orientation|pronoun",
      "option_re": "decline|prefer not|not to (answer|identify|disclose|say)|don'?t (wish|want)|do not (wish|want)|not declared",
      "answer_from": "eeo_decline"
    }
  },
